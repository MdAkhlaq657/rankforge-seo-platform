# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://seoplatform:seoplatform@postgres:5432/seoplatform
DATABASE_URL_SYNC=postgresql://seoplatform:seoplatform@postgres:5432/seoplatform

# ── Redis / Celery ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-64-char-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
PROJECT_NAME=SEO Platform

# ── Third-party APIs (leave blank to use mock data) ───────────────────────────
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
GOOGLE_PSI_API_KEY=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── AI (Phase 2) ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Google OAuth (Phase 2) ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/oauth/callback

# ── Stripe (Phase 3) ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_GROWTH=
STRIPE_PRICE_ID_AGENCY=
